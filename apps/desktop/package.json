    "electron": "^43.4.0",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  }
