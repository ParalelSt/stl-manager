# Personal specs and plans are never committed.
# Any markdown file whose name contains "spec" or "plan" is excluded.
*spec*.md
*Spec*.md
*SPEC*.md
*plan*.md
*Plan*.md
*PLAN*.md

# Local rules directory
Claude rules/

# Dependencies
node_modules/

# Build output
dist/
out/
build/
# The desktop packaging assets are inputs, not output: the icon, the
# entitlements and the notarisation hook are needed to build a release.
!apps/desktop/build/
*.tsbuildinfo

# Electron packaging
release/

# Environment and secrets
.env
.env.*
!.env.example

# Editor and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Test and coverage
coverage/

# Runtime data written by the app during development
.stl-manager/

# Electron build output
apps/desktop/out/

# Server web build
apps/server/dist-web/

# Packaged applications
apps/desktop/release/

# Test fixtures, kept inside the project
.tmp/
